# ─────────────────────────────────────────────────────────────
# Deployed configuration. Committed on purpose.
#
# Next loads this file at runtime in production, so Vercel picks it up straight from the
# repo and there is nothing to type into a dashboard. Real environment variables still win
# over anything here — dotenv never overwrites a value the platform already set — so
# setting any of these in the Vercel UI later overrides this file rather than clashing
# with it.
#
# This is only safe because the repository is private. Nothing in here may be moved into a
# public repo: these tokens are full read/write access to both databases.
#
# Local development does not read this file: `.env.local` takes precedence.
# ─────────────────────────────────────────────────────────────
# The user's book — positions and history. Already used by /api/book.
UPSTASH_REDIS_REST_URL="https://picked-feline-66060.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAQIMAAIgcDE2NWRlYzZiMjQ3Yzc0MzAzYTBhMjlkOTdkNGJlYjljNg"

# Market data: a SEPARATE database holding nothing but OHLC bars, published outbound by
# the MT5 terminal on the VPS. Must match MARKET_REDIS_* in that project's .env.
#

AUTH_USERNAME=usergn
AUTH_PASSWORD=KDp6Nt
